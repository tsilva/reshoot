{
  "name": "reshoot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "python3 scripts/infisical/run.py dev",
    "build": "next build",
    "start": "node scripts/dev-server.mjs next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev:app": "node scripts/dev-server.mjs next dev",
    "build:secrets": "python3 scripts/infisical/run.py build",
    "start:secrets": "python3 scripts/infisical/run.py start",
    "secrets:check": "python3 scripts/infisical/run.py check",
    "secrets:migrate:keyenv": "python3 scripts/infisical/migrate_keyenv.py",
    "test:secrets": "python3 -m unittest discover -s scripts/infisical -p test_secrets.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.3.8",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^11.2.0",
    "@vercel/analytics": "2.0.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "next": "16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "workflow": "4.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@workflow/vitest": "4.0.18",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
