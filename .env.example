# Optional server-only AgentBridge access token.
AGENTBRIDGE_API_KEY=

# Neon pooled Postgres connection string.
DATABASE_URL=

# Deployed Clerk keys are owned by the native Clerk/Vercel integration.
# Keep Production and Preview keys separate; never mirror them in Infisical.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true

# Only stripe_test and disabled are supported. Missing/legacy modes disable checkout.
RESHOOT_PAYMENTS_MODE=stripe_test

# Server-only Stripe sandbox credentials from the reviewed secrets route.
# Use an rk_test_ restricted key; live keys are rejected. Never paste real keys here.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Private Cloudflare R2 storage. Never expose these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=reshoot-development
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bearer secret used by Vercel Cron to run reconciliation and retention cleanup.
CRON_SECRET=

# Public GA4 Measurement ID. Configure this only for production deployments.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

AGENTBRIDGE_BASE_URL=http://127.0.0.1:8082/api/v1

# Deployment-only, from this app’s isolated production vault. Never reuse a development key.
OPENROUTER_API_KEY=

# Non-secret server configuration for the monthly sandbox plans.
# These are existing Stripe object IDs; the application never provisions them.
STRIPE_TEST_STARTER_MONTHLY_PRICE_ID=
STRIPE_TEST_STUDIO_MONTHLY_PRICE_ID=
STRIPE_TEST_PRO_MONTHLY_PRICE_ID=
STRIPE_TEST_PORTAL_CONFIGURATION_ID=
